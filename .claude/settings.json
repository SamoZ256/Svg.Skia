{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gh-pr-guard.py",
            "if": "Bash(gh pr *)",
            "timeout": 10,
            "statusMessage": "Checking the pull request target"
          }
        ]
      }
    ]
  }
}
