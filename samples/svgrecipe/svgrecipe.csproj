<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>True</IsPackable>
    <IsTool>True</IsTool>
    <PackAsTool>True</PackAsTool>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Rewrites a plain Svg drawing into the Svg expression extension format, driven by a recipe file.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>svgrecipe</PackageId>
    <PackageTags>svg;expressions;recipe;authoring;codegen;graphics</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\build\SignAssembly.props" />
  <Import Project="..\..\build\ReferenceAssemblies.props" />

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Svg.Expressions.Recipes\Svg.Expressions.Recipes.csproj" />
  </ItemGroup>

</Project>
