<?xml version="1.0" encoding="utf-8"?>
<recipe xmlns="https://svg.skia/expr/1.0">

  <!-- Copied verbatim into <defs><e:code> of the converted document. -->
  <code>
    <param name="hue" type="number" default="0.58" />
    <param name="warm" type="number" default="0" />
    <param name="dark" type="boolean" default="false" />

    <let name="tone">hue * 360 + warm * 60</let>
    <let name="body">hsl(tone, 72%, dark ? 34% : 58%)</let>
  </code>

  <!-- The icon paints one colour. Every occurrence of it becomes the expression. -->
  <replace color="#000000">body</replace>
</recipe>
