<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>True</IsPackable>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <!--
      Reached from inside the compiler: Svg.CodeGen.Skia is loaded as part of
      Svg.SourceGenerator.Skia and this is one of its dependencies, so the rules an analyzer has to
      obey apply here too. RS1035 bans Environment, file IO and the rest, which is why
      ExprException renders its diagnostic with "\n" rather than Environment.NewLine.
    -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <PropertyGroup>
    <Description>The SVG expression language: lexer, parser and type checker, shared by the code generator and by runtime evaluation.</Description>
    <PackageId>Svg.Expressions</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>svg;expressions;parser;compiler;csharp;graphics</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\build\SourceLink.props" />
  <Import Project="..\..\build\SignAssembly.props" />
  <Import Project="..\..\build\ReferenceAssemblies.props" />

  <ItemGroup>
    <!-- Build time only: it is what implements the RS1035 checks the setting above turns on. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
