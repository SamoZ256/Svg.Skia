<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!--
      Multi-targeted for MathF, which arrived with netstandard2.1. Generated code calls MathF, so
      the evaluator has to as well: (float)Math.Sin((double)x) differs from MathF.Sin(x) by an ulp
      on about 1.4% of a 57,000-sample sweep, and Tan on 7.3%. netstandard2.0 is still built, both
      for net461 consumers and because it is the flavour loaded into the compiler as part of the
      source generator, and it falls back — see ExprMath.
    -->
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>True</IsPackable>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <!--
      Reached from inside the compiler: Svg.CodeGen.Skia is loaded as part of
      Svg.SourceGenerator.Skia and this is one of its dependencies, so the rules an analyzer has to
      obey apply here too. RS1035 bans Environment, file IO and the rest, which is why
      ExprException renders its diagnostic with "\n" rather than Environment.NewLine.
    -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <PropertyGroup>
    <Description>The SVG expression language: lexer, parser and type checker, shared by the code generator and by runtime evaluation.</Description>
    <PackageId>Svg.Expressions</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>svg;expressions;parser;compiler;csharp;graphics</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\build\SourceLink.props" />
  <Import Project="..\..\build\SignAssembly.props" />
  <Import Project="..\..\build\ReferenceAssemblies.props" />

  <ItemGroup>
    <!-- Build time only: it is what implements the RS1035 checks the setting above turns on. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
