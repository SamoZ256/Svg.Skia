<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Svg.Studio.App">
  <!--
    No RequestedThemeVariant here: it is a setting, and Initialize puts the answer on file onto the
    application before anything is shown. It used to say Dark, which is why everything painted for
    a dark ground and nothing was ever looked at on a light one.
  -->
  <Application.Styles>
    <FluentTheme />

    <!-- The ground every window stands on, which Fluent leaves pure black in the dark variant. -->
    <StyleInclude Source="avares://Svg.Studio/StudioChrome.axaml" />
  </Application.Styles>

  <!--
    The application's own menu, which on macOS is the one under the app's name — where a Mac keeps
    its settings, with the shortcut every Mac application answers to. Avalonia adds Services, Hide
    and Quit after whatever is put here. It reaches nothing on Windows or Linux, which have no such
    menu, so the window carries the same item there instead.
  -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="Settings…" Gesture="Cmd+," Click="OnSettings" />
    </NativeMenu>
  </NativeMenu.Menu>
</Application>
