<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Svg.Studio.MainWindow"
        Width="1180" Height="760"
        MinWidth="720" MinHeight="480"
        Title="SVG Studio">

  <Window.Styles>
    <!--
      Fluent's own TabControl template wraps the tabs onto a second row as they overflow, which
      pushes the drawing down and moves every tab as one is added. One row that scrolls instead
      leaves a tab where its owner put it, which is the point of being able to arrange them.
    -->
    <!--
      Fluent styles a TabItem as a pivot header — 24pt type, a sliding pipe under the selected one —
      which suits three or four sections, not a strip of open documents. These are document tabs:
      one row of uniform height, the selected one lifted out of the band as a rounded card, the rest
      quiet until the pointer is over them. Every colour is a neutral grey at low alpha, so the strip
      sits on whatever the theme paints behind it.
    -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="#18808080" BorderThickness="0,0,1,0"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Height="34">
            <ContentPresenter Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="#14808080" />
    </Style>

    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="#2E808080" />
      <Setter Property="CornerRadius" Value="5,5,0,0" />
    </Style>

    <!-- The name of the drawing: quiet on a tab that is not the one being looked at. -->
    <Style Selector="TabItem TextBlock.title">
      <Setter Property="MaxWidth" Value="180" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>

    <Style Selector="TabItem:selected TextBlock.title">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!--
      The unsaved mark, before the name because that is the edge the eye runs down when scanning a
      strip for the tab that still needs saving.
    -->
    <Style Selector="TabItem TextBlock.marker">
      <Setter Property="Text" Value="●" />
      <Setter Property="FontSize" Value="9" />
      <!--
        Sized and always present rather than shown and hidden: a mark that appears would widen the
        tab and shove every name along the strip, which is a worse tell than the mark is a good one.
      -->
      <Setter Property="Width" Value="9" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Foreground" Value="#4C9BE8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TabItem TextBlock.marker.unsaved">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!--
      The close button has no business looking like a button until it is being used: Fluent's own
      chrome next to a file name reads as a second control competing with the tab.
    -->
    <Style Selector="Button.close">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <!--
        Out of sight until the tab is being looked at or pointed at: a row of crosses is what makes
        a tab strip look busy. It keeps its space so no tab changes width, and nothing can be
        clicked unseen — reaching it means hovering the tab first, which is what reveals it.
      -->
      <Setter Property="Opacity" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.close /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="TabItem:selected Button.close">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="TabItem:pointerover Button.close">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="Button.close:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#38808080" />
    </Style>

    <Style Selector="Button.close:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#50808080" />
    </Style>

    <Style Selector="TabControl#Tabs">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel>
            <Border Name="PART_TabStripBand" DockPanel.Dock="Top" Background="#10808080"
                    BorderBrush="#20808080" BorderThickness="0,0,0,1">
              <ScrollViewer Name="PART_TabStrip"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
            <ContentPresenter Name="PART_SelectedContentHost"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </Style>
  </Window.Styles>

  <!--
    Declared once as a native menu and shown by a NativeMenuBar: on macOS the bar draws nothing and
    the items go to the system menu bar, where a File menu belongs, and everywhere else the same
    items are drawn in the window.
  -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open…" Click="OnOpen" />
            <!--
              One command for both forms: the save panel asks which, and names the file after the
              answer, so nothing here has to ask twice.
            -->
            <NativeMenuItem Header="Export…" Click="OnExport" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <!--
        Edit rather than File: a resize changes the drawing, and the tab goes modified until it is
        saved like any other edit.
      -->
      <NativeMenuItem Header="Edit">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <!--
              The gestures are set in code from the platform's own keymap rather than written here,
              so what the menu shows is what the pane answers to on this machine.
            -->
            <NativeMenuItem Header="Undo" Click="OnUndo" />
            <NativeMenuItem Header="Redo" Click="OnRedo" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Resize…" Click="OnResize" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <!--
        Its own menu rather than an item in File: what it acts on is the whole project, not the
        drawing being looked at, which is what everything in File and Edit is about.
      -->
      <NativeMenuItem Header="Project">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Build" Click="OnBuild" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Close" Click="OnCloseProject" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <DockPanel LastChildFill="True">
    <NativeMenuBar DockPanel.Dock="Top" />

    <!--
      The tree belongs to the window rather than to a tab: it names the drawings the tabs hold, so
      it has to stay up while one of them is being looked at. Collapsed to nothing until a project
      is opened, so a session that only opens drawings looks exactly as it did.
    -->
    <Grid x:Name="Shell">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0" />
        <ColumnDefinition Width="0" />
        <ColumnDefinition Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <Border x:Name="ProjectPaneHost" Grid.Column="0" IsVisible="False"
              BorderThickness="0,0,1,0" BorderBrush="#20808080">
        <DockPanel>
          <TextBlock x:Name="ProjectName" DockPanel.Dock="Top" Margin="10,10,10,6"
                     FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
          <!--
            The settings of the row picked out in the tree. Under it rather than in a tab, because
            a drawing's tab is the viewer: what is edited here is the project's say over the file,
            not the file.
          -->
          <Border x:Name="ProjectSettings" DockPanel.Dock="Bottom" IsVisible="False"
                  MaxHeight="340" BorderThickness="0,1,0,0" BorderBrush="#20808080" />

          <Grid DragDrop.AllowDrop="True">
            <TreeView x:Name="ProjectTree" Background="Transparent" BorderThickness="0" />
            <!--
              Where a dragged row would land. Over the tree rather than in it, so it takes no room
              in the layout and cannot take the pointer: a line between two rows on the way past,
              and the outline of a group when the drop would go inside one.
            -->
            <Border x:Name="DropLine" IsVisible="False" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderBrush="#4C9BE8" Background="#4C9BE8" />
          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter x:Name="ProjectSplitter" Grid.Column="1" IsVisible="False"
                    ResizeDirection="Columns" Background="Transparent" />

      <TabControl x:Name="Tabs" Grid.Column="2" Padding="0" />
    </Grid>
  </DockPanel>

</Window>
