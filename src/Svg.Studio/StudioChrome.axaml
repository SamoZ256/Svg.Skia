<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The colours the editor paints its chrome with: UnoDraw's palette, which the viewer library holds
    so that a dock outside Studio paints the same. Change a colour there, not by overriding its key
    here: every dock merges a copy of its own, which wins inside it, so only the rows round it would move.

    In a file of its own rather than in App.axaml so that the suite can include it — App is the one
    class a test cannot reach, since it builds an Application of its own, and a colour nothing can
    look at is a colour nobody checked.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Svg.Viewer.Skia.Avalonia/SvgViewerPalette.axaml" />
        <!-- The viewer's own, for its note: the window's status bar says it now. -->
        <ResourceInclude Source="avares://Svg.Viewer.Skia.Avalonia/SvgViewerSourceBrushes.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <!-- UnoDraw's canvas, darker than the panels in both variants so the drawing reads as sunk into them. -->
          <Color x:Key="SvgViewerCanvasGround">#1E1E1E</Color>
          <!-- The viewer's SvgViewerDrivenBrush, for Studio's own chrome: the Attributes panel's
               merged dictionary shadows an app-level key, so the two are kept equal by a test. -->
          <SolidColorBrush x:Key="StudioDrivenBrush" Color="#C586C0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="SvgViewerCanvasGround">#BABABA</Color>
          <SolidColorBrush x:Key="StudioDrivenBrush" Color="#A626A4" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!--
    Every window, so the dialogs the viewer opens stand on the same ground as the editor behind them.
    Fluent's own is literally Black in the dark variant, and every pane here is transparent over it.
  -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
  </Style>

</Styles>
