<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Svg.Studio.SettingsWindow"
        Title="Settings"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <!--
    Applied as it is switched, with nothing to confirm: a settings window with OK and Cancel is a
    Windows habit, and on macOS a preference takes effect where it is set.
  -->
  <StackPanel Margin="20" Spacing="6">
    <CheckBox x:Name="AutosaveBox" Content="Keep a copy of unsaved work" />

    <!--
      What it does rather than what it is: the copy is the part nobody would guess, and the sentence
      has to say that the project's own file is still the author's to write.
    -->
    <TextBlock Text="Studio keeps a copy of the project while it holds work that is not on disk, under your application data, and offers it back if Studio does not close cleanly. The project's own file is written only when you save it."
               TextWrapping="Wrap"
               Opacity="0.65"
               FontSize="11"
               Margin="26,0,0,0" />

    <TextBlock Text="Caption size" Margin="0,14,0,0" />

    <!--
      A caption is chrome rather than part of a drawing, so it is drawn at one size whatever the
      zoom — and how big is readable is about the screen rather than about the drawings.
    -->
    <NumericUpDown x:Name="CaptionSizeBox"
                   HorizontalAlignment="Left"
                   Width="120"
                   Increment="1"
                   FormatString="0" />

    <TextBlock Text="How big the name above a group's frame is drawn on a board. It does not change with the zoom."
               TextWrapping="Wrap"
               Opacity="0.65"
               FontSize="11" />

    <TextBlock Text="Relaxed text layout" Margin="0,14,0,0" />

    <!--
      Three answers rather than a box, because the third one is the useful default: it only comes up
      for a drawing whose words an expression writes, and until somebody has seen what it costs
      there is no answer to remember.
    -->
    <ComboBox x:Name="RelaxedTextBox" HorizontalAlignment="Left" Width="200" />

    <TextBlock Text="An export writes text an expression drives as an argument where it can. Where the drawing places that text per glyph — a span of its own, a length to fit, a path to follow — it can either give those rules up and draw the text anyway, or write the default in and tell you which drawings it did that to."
               TextWrapping="Wrap"
               Opacity="0.65"
               FontSize="11" />
  </StackPanel>
</Window>
