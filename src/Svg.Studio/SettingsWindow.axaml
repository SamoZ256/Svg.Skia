<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Svg.Studio.SettingsWindow"
        Title="Settings"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <!--
    Applied as it is switched, with nothing to confirm: a settings window with OK and Cancel is a
    Windows habit, and on macOS a preference takes effect where it is set.
  -->
  <StackPanel Margin="20" Spacing="6">
    <TextBlock Text="Theme" />

    <!--
      First, because it is the only setting here that changes what the window in front of you looks
      like while you are looking at it. Three answers rather than a switch: following the machine is
      a third thing and not the middle of the other two.
    -->
    <ComboBox x:Name="ThemeBox" HorizontalAlignment="Left" Width="200" />

    <TextBlock Text="Which way round Studio is painted. Same as system follows the machine, so an editor left open turns dark with it at sunset."
               TextWrapping="Wrap"
               Opacity="0.65"
               FontSize="11" />

    <CheckBox x:Name="AutosaveBox" Content="Keep a copy of unsaved work" Margin="0,14,0,0" />

    <!--
      What it does rather than what it is: the copy is the part nobody would guess, and the sentence
      has to say that the project's own file is still the author's to write.
    -->
    <TextBlock Text="Studio keeps a copy of the project while it holds work that is not on disk, under your application data, and offers it back if Studio does not close cleanly. The project's own file is written only when you save it."
               TextWrapping="Wrap"
               Opacity="0.65"
               FontSize="11"
               Margin="26,0,0,0" />

    <TextBlock Text="Caption size" Margin="0,14,0,0" />

    <!--
      A caption is chrome rather than part of a drawing, so it is drawn at one size whatever the
      zoom — and how big is readable is about the screen rather than about the drawings.
    -->
    <NumericUpDown x:Name="CaptionSizeBox"
                   HorizontalAlignment="Left"
                   Width="120"
                   Increment="1"
                   FormatString="0" />

    <TextBlock Text="How big the name under a drawing, and the name inside a group's frame, is drawn on a board. It does not change with the zoom."
               TextWrapping="Wrap"
               Opacity="0.65"
               FontSize="11" />

    <CheckBox x:Name="DrawingCaptionsBox" Content="Name each drawing on a board" Margin="0,14,0,0" />

    <!--
      On, unlike the toggle this replaces. A name is now written inside the drawing and shrunk to fit
      across it, so a board that names what is on it is laid out exactly like one that does not —
      the room the writing used to take is what made it something to turn off.
    -->
    <TextBlock Text="Writes each drawing's name inside its own top corner, where a group's name sits in its frame. The name is shrunk until it fits the drawing, so nothing moves either way. A group's own name is written whatever this says."
               TextWrapping="Wrap"
               Opacity="0.65"
               FontSize="11"
               Margin="26,0,0,0" />

    <CheckBox x:Name="SnapToGridBox" Content="Snap to grid" Margin="0,14,0,0" />

    <!--
      What it covers rather than what it is: "snap to grid" says nothing about the angle, and a
      gesture that stops writing what the pointer said is worth knowing about before it happens.
    -->
    <TextBlock Text="Everything dragged on a canvas lands on the grid rather than where the pointer stopped: a drawing's place on a board, an element inside one, the size of either, and the angle a turn comes to. The grid is drawn while this is on. Numbers you type are still the numbers you typed."
               TextWrapping="Wrap"
               Opacity="0.65"
               FontSize="11"
               Margin="26,0,0,0" />

    <TextBlock Text="Grid size" Margin="0,14,0,0" />

    <NumericUpDown x:Name="GridSizeBox"
                   HorizontalAlignment="Left"
                   Width="120"
                   Increment="1"
                   FormatString="0.##" />

    <TextBlock Text="How far apart the lines are, in the units a board arranges drawings in — which in a drawing's own tab are the drawing's own."
               TextWrapping="Wrap"
               Opacity="0.65"
               FontSize="11" />

    <TextBlock Text="Rotation step" Margin="0,14,0,0" />

    <!--
      Its own number because a grid has no angle, and the two are not the same kind of thing: a step
      of ten lines is a length, a step of ten degrees is a sixth of a right angle.
    -->
    <NumericUpDown x:Name="RotationStepBox"
                   HorizontalAlignment="Left"
                   Width="120"
                   Increment="5"
                   FormatString="0.##" />

    <TextBlock Text="How far apart the angles a turn lands on are, in degrees."
               TextWrapping="Wrap"
               Opacity="0.65"
               FontSize="11" />

    <TextBlock Text="Relaxed text layout" Margin="0,14,0,0" />

    <!--
      Three answers rather than a box, because the third one is the useful default: it only comes up
      for a drawing whose words an expression writes, and until somebody has seen what it costs
      there is no answer to remember.
    -->
    <ComboBox x:Name="RelaxedTextBox" HorizontalAlignment="Left" Width="200" />

    <TextBlock Text="An export writes text an expression drives as an argument where it can. Where the drawing places that text per glyph — a span of its own, a length to fit, a path to follow — it can either give those rules up and draw the text anyway, or write the default in and tell you which drawings it did that to."
               TextWrapping="Wrap"
               Opacity="0.65"
               FontSize="11" />
  </StackPanel>
</Window>
