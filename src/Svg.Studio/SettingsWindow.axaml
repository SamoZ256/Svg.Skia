<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Svg.Studio.SettingsWindow"
        Title="Settings"
        Width="460"
        Height="440"
        MinWidth="400"
        MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <!--
    Applied as it is switched, with nothing to confirm: a settings window with OK and Cancel is a
    Windows habit, and on macOS a preference takes effect where it is set.

    A fixed size with a scrolling page per tab, rather than sized to its content: it grew a setting at
    a time until it ran off the screen with no way to reach the bottom. What each setting does is in
    its tooltip; what is left on the page is what you set, and the lines that say what is kept now.
  -->
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="StackPanel.page">
      <Setter Property="Margin" Value="16,12,16,16" />
      <Setter Property="Spacing" Value="14" />
    </Style>
    <Style Selector="StackPanel.setting">
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.group">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.65" />
    </Style>
  </Window.Styles>

  <TabControl x:Name="SettingsTabs" Padding="0">
    <TabItem Header="General">
      <ScrollViewer>
        <StackPanel Classes="page">
          <StackPanel Classes="setting">
            <TextBlock Text="Theme" />
            <!--
              Three answers rather than a switch: following the machine is a third thing and not the
              middle of the other two.
            -->
            <ComboBox x:Name="ThemeBox" HorizontalAlignment="Left" Width="200"
                      ToolTip.Tip="Same as system follows the machine, so an open editor turns dark with it." />
          </StackPanel>

          <CheckBox x:Name="AutosaveBox" Content="Keep a copy of unsaved work"
                    ToolTip.Tip="A copy kept under your application data while there is work not on disk, offered back if Studio does not close cleanly. The project's own file is written only when you save." />

          <Button x:Name="ResetLayoutButton" Content="Reset panel layout" HorizontalAlignment="Left"
                  ToolTip.Tip="Puts every panel back where it started." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Canvas">
      <ScrollViewer>
        <StackPanel Classes="page">
          <!--
            What it covers rather than what it is: "snap to grid" says nothing about the angle, and a
            gesture that stops writing what the pointer said is worth knowing about before it happens.
          -->
          <CheckBox x:Name="SnapToGridBox" Content="Snap to grid"
                    ToolTip.Tip="Dragging lands on the grid: a drawing's place, an element, a size and the angle of a turn. Typed numbers stay as typed." />

          <StackPanel Classes="setting">
            <TextBlock Text="Grid size" />
            <NumericUpDown x:Name="GridSizeBox" HorizontalAlignment="Left" Width="120" Increment="1" FormatString="0.##"
                           ToolTip.Tip="How far apart the lines are, in the units of the board or drawing." />
          </StackPanel>

          <StackPanel Classes="setting">
            <TextBlock Text="Rotation step" />
            <!--
              Its own number because a grid has no angle: a step of ten lines is a length, a step of
              ten degrees is a ninth of a right angle.
            -->
            <NumericUpDown x:Name="RotationStepBox" HorizontalAlignment="Left" Width="120" Increment="5" FormatString="0.##"
                           ToolTip.Tip="The angles a turn lands on, in degrees." />
          </StackPanel>

          <StackPanel Classes="setting">
            <TextBlock Text="Caption size" />
            <!--
              Chrome rather than part of a drawing, so one size whatever the zoom: how big is
              readable is about the screen, not the drawings.
            -->
            <NumericUpDown x:Name="CaptionSizeBox" HorizontalAlignment="Left" Width="120" Increment="1" FormatString="0"
                           ToolTip.Tip="How big names are drawn on a board. It does not change with the zoom." />
          </StackPanel>

          <!--
            On, unlike the toggle this replaced: the name is shrunk to fit inside the drawing, so a
            board that names what is on it is laid out exactly like one that does not.
          -->
          <CheckBox x:Name="DrawingCaptionsBox" Content="Name each drawing on a board"
                    ToolTip.Tip="Writes each drawing's name in its top corner, shrunk to fit, so nothing moves. A group's name is always shown." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Import &amp; export">
      <ScrollViewer>
        <StackPanel Classes="page">
          <StackPanel Classes="setting">
            <TextBlock Text="Text an export cannot keep exact" />
            <!--
              Three answers rather than a box, because asking is the useful default: it only comes
              up for a drawing whose words an expression writes.
            -->
            <ComboBox x:Name="RelaxedTextBox" HorizontalAlignment="Left" Width="200"
                      ToolTip.Tip="Text an expression drives, placed glyph by glyph (a span, a fitted length, a path): relax those rules and draw it, or write the default text in and list the drawings." />
          </StackPanel>

          <StackPanel Classes="setting">
            <!--
              The two choices sit under the question they answer, so turning it off still leaves them
              reachable: they are what every conversion uses while nothing asks.
            -->
            <CheckBox x:Name="ConvertAsksBox" Content="Ask how to convert a PaintCode document"
                      ToolTip.Tip="Without the question, a PaintCode document is converted straight away with the two choices below." />
            <StackPanel Margin="26,0,0,0" Spacing="4">
              <CheckBox x:Name="ConvertIntegersBox" Content="Write whole numbers as integers" />
              <CheckBox x:Name="ConvertOrganizesBox" Content="Automatically organize variables" />
            </StackPanel>
          </StackPanel>

          <CheckBox x:Name="DropAsksBox" Content="Ask which template to use when Streamline icons are dropped"
                    ToolTip.Tip="Without the question, a drop imports the icons whose template is sure straight away; the rest still ask." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Accounts">
      <ScrollViewer>
        <StackPanel Classes="page">
          <TextBlock Classes="group" Text="KEYS" />

          <!--
            Never shown back, only said to be there: the box is for putting a key in, and the keychain
            is where it lives.
          -->
          <StackPanel Classes="setting">
            <TextBlock Text="Streamline API key" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox x:Name="StreamlineKeyBox" Width="220" PasswordChar="•" />
              <Button x:Name="ForgetStreamlineKeyButton" Content="Forget" />
            </StackPanel>
            <TextBlock x:Name="StreamlineKeyStatusText" Classes="note" />
          </StackPanel>

          <StackPanel Classes="setting">
            <TextBlock Text="Anthropic API key" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox x:Name="AnthropicKeyBox" Width="220" PasswordChar="•" />
              <Button x:Name="ForgetAnthropicKeyButton" Content="Forget" />
            </StackPanel>
            <TextBlock x:Name="AnthropicKeyStatusText" Classes="note" />
          </StackPanel>

          <TextBlock Classes="group" Text="CLAUDE CODE" Margin="0,6,0,0" />

          <!--
            Off by default: it opens a port. The copied command carries the token, which is kept in
            the keychain and never shown here on its own.
          -->
          <StackPanel Classes="setting">
            <CheckBox x:Name="McpEnabledBox" Content="Let Claude Code connect to this Studio"
                      ToolTip.Tip="Serves the assistant's tools over MCP on this machine only, to a client holding the token." />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Port" VerticalAlignment="Center" />
              <NumericUpDown x:Name="McpPortBox" Width="120" Increment="1" FormatString="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="CopyMcpCommandButton" Content="Copy command"
                      ToolTip.Tip="Copies the claude mcp add command that connects Claude Code to this Studio." />
              <Button x:Name="NewMcpTokenButton" Content="New token"
                      ToolTip.Tip="Replaces the token, so a command copied before stops working." />
            </StackPanel>
            <TextBlock x:Name="McpStatusText" Classes="note" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
