<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewer="clr-namespace:Svg.Viewer.Skia.Avalonia"
             x:Class="Svg.Viewer.Skia.Avalonia.SvgViewerParameterPanel">

  <UserControl.Styles>
    <!-- ColorPicker ships its control theme in its own assembly, not in FluentTheme. Without this
         the picker is created and templated with nothing, so a colour parameter shows an empty gap
         where its control should be. Included here rather than left to the host, so a consumer that
         drops this panel in gets a working picker without knowing any of that. -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
  </UserControl.Styles>

  <UserControl.DataTemplates>

    <!-- Resolved by the concrete row type, so there is no selector to keep in step. -->
    <DataTemplate DataType="viewer:SvgViewerNumberParameter">
      <StackPanel Spacing="2" Margin="0,0,0,10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="monospace" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1"
                         Width="110"
                         Value="{Binding Value, Mode=TwoWay}"
                         Minimum="{Binding Minimum}"
                         Maximum="{Binding Maximum}"
                         Increment="{Binding TickFrequency}"
                         ShowButtonSpinner="False" />
        </Grid>
        <Slider Minimum="{Binding Minimum}"
                Maximum="{Binding Maximum}"
                TickFrequency="{Binding TickFrequency}"
                IsSnapToTickEnabled="{Binding HasStep}"
                Value="{Binding Value, Mode=TwoWay}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="viewer:SvgViewerBooleanParameter">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="monospace" VerticalAlignment="Center" />
        <CheckBox Grid.Column="1" IsChecked="{Binding Value, Mode=TwoWay}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="viewer:SvgViewerColorParameter">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="monospace" VerticalAlignment="Center" />
        <ColorPicker Grid.Column="1" Color="{Binding Color, Mode=TwoWay}" />
      </Grid>
    </DataTemplate>

  </UserControl.DataTemplates>

  <DockPanel>

    <!--
      Below the rows rather than above them, so that adding a parameter does not move the controls
      somebody is using, and so the count of what is uncommitted sits nearest the button that
      commits it.
    -->
    <StackPanel DockPanel.Dock="Bottom" x:Name="Actions" Margin="10,0,10,10" Spacing="6">

      <Border Height="1" Background="#20808080" Margin="0,4,0,2" />

      <!-- Only there when there is something to commit; a count is the whole of what it has to say. -->
      <TextBlock x:Name="CommitLabel" IsVisible="False" Opacity="0.6" FontSize="11" TextWrapping="Wrap" />

      <Button x:Name="CommitButton"
              Content="Commit as defaults"
              IsVisible="False"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              ToolTip.Tip="Writes each value into the drawing as the parameter's default. A default written as an expression is replaced by the number it currently evaluates to." />

      <Button x:Name="AddButton"
              Content="Add parameter…"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" />

    </StackPanel>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="10">

        <!-- Hidden until a drawing is read: an empty pane before anything is open has nothing to
             explain, and one behind a file that would not open has nothing to say about it. -->
        <TextBlock x:Name="EmptyLabel"
                   Text="This drawing declares no parameters."
                   IsVisible="False"
                   Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8" />

        <ItemsControl x:Name="Rows" />

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
