<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The bar at the top of every run of the dock: a chevron that folds it, and a name per panel in it.

    Written out rather than templated over TabItem, which is what this used to be. Fluent styles a
    TabItem as a pivot header — 24pt type over a sliding pipe — half the width of the strip it sits
    in, and even re-templated it swapped its content out when the tab changed, so nothing about a
    panel could be found until somebody had clicked it. These are the same two states painted on a
    Border, and every panel's content stays in the tree whether or not it is the one on top.

    Its own file because the dock is not the only thing wearing them: a project group's board in
    Svg.Studio builds the same body, and two strips meant to look alike would not stay that way.
  -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Svg.Viewer.Skia.Avalonia/SvgViewerPalette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Border.slot">
    <Setter Property="Background" Value="{DynamicResource StudioHeader}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioDivider}" />
    <Setter Property="MinHeight" Value="26" />
  </Style>

  <Style Selector="Border.pane">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Border.pane > TextBlock">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.pane.selected">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
  </Style>

  <Style Selector="Border.pane:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Reached by the arrow keys, so it has to show where the keyboard is. -->
  <Style Selector="Border.pane:focus-visible">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Background" Value="{DynamicResource StudioSelection}" />
  </Style>

  <!-- The rest of a run too narrow for its tabs: quiet like the chevron, since it is the same kind of thing. -->
  <Style Selector="Button.more">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="Button.more:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- The gap between two panels, which is dragged to resize them: nothing until the pointer is on it. -->
  <Style Selector="GridSplitter.gap">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="GridSplitter.gap:pointerover, GridSplitter.gap:pressed">
    <Setter Property="Background" Value="{DynamicResource StudioAccent}" />
  </Style>

  <!-- The line between one pane and the next. -->
  <Style Selector="Border.divider">
    <Setter Property="BorderBrush" Value="{DynamicResource StudioDivider}" />
  </Style>

  <Style Selector="Border.chevron">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Border.chevron:pointerover">
    <Setter Property="Opacity" Value="0.9" />
  </Style>

</Styles>
