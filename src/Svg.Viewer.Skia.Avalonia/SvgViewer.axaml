<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewer="clr-namespace:Svg.Viewer.Skia.Avalonia"
             x:Class="Svg.Viewer.Skia.Avalonia.SvgViewer"
             DragDrop.AllowDrop="True">

  <UserControl.Resources>
    <ResourceDictionary>
      <!--
        Resources rather than constants so a host can restyle the pane, and theme dictionaries
        because a palette picked for a dark background is unreadable on a white one.
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SvgViewerSourceTextBrush" Color="#D4D4D4" />
          <SolidColorBrush x:Key="SvgViewerSourcePunctuationBrush" Color="#808080" />
          <SolidColorBrush x:Key="SvgViewerSourceElementBrush" Color="#569CD6" />
          <SolidColorBrush x:Key="SvgViewerSourceAttributeBrush" Color="#9CDCFE" />
          <SolidColorBrush x:Key="SvgViewerSourceValueBrush" Color="#CE9178" />
          <SolidColorBrush x:Key="SvgViewerSourceCommentBrush" Color="#6A9955" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionBrush" Color="#C586C0" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionNumberBrush" Color="#B5CEA8" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionColorBrush" Color="#4EC9B0" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionFunctionBrush" Color="#DCDCAA" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionConstantBrush" Color="#4FC1FF" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionKeywordBrush" Color="#C586C0" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionOperatorBrush" Color="#D4D4D4" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionPunctuationBrush" Color="#909090" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionIdentifierBrush" Color="#9CDCFE" />
          <SolidColorBrush x:Key="SvgViewerSourceLineNumberBrush" Color="#5A5A5A" />
          <SolidColorBrush x:Key="SvgViewerSourceErrorBrush" Color="#FF6B6B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SvgViewerSourceTextBrush" Color="#1F1F1F" />
          <SolidColorBrush x:Key="SvgViewerSourcePunctuationBrush" Color="#6E6E6E" />
          <SolidColorBrush x:Key="SvgViewerSourceElementBrush" Color="#0000C0" />
          <SolidColorBrush x:Key="SvgViewerSourceAttributeBrush" Color="#0451A5" />
          <SolidColorBrush x:Key="SvgViewerSourceValueBrush" Color="#A31515" />
          <SolidColorBrush x:Key="SvgViewerSourceCommentBrush" Color="#008000" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionBrush" Color="#A626A4" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionNumberBrush" Color="#098658" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionColorBrush" Color="#0E7C6B" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionFunctionBrush" Color="#795E26" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionConstantBrush" Color="#0070C1" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionKeywordBrush" Color="#A626A4" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionOperatorBrush" Color="#1F1F1F" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionPunctuationBrush" Color="#5A5A5A" />
          <SolidColorBrush x:Key="SvgViewerSourceExpressionIdentifierBrush" Color="#001080" />
          <SolidColorBrush x:Key="SvgViewerSourceLineNumberBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="SvgViewerSourceErrorBrush" Color="#D40000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel LastChildFill="True">

    <Border x:Name="ToolBarPanel" DockPanel.Dock="Top"
            Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="#20808080">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button x:Name="OpenButton" Content="Open…" />
        <Rectangle Width="1" Fill="#30808080" Margin="4,2" />
        <Button x:Name="FitButton" Content="Fit" ToolTip.Tip="Fit to window (Ctrl+0)" />
        <Button x:Name="ActualSizeButton" Content="1:1" ToolTip.Tip="Actual size (Ctrl+1)" />
        <Button x:Name="ResetButton" Content="Reset" ToolTip.Tip="Reset pan and zoom" />
        <Rectangle Width="1" Fill="#30808080" Margin="4,2" />
        <Button x:Name="ZoomOutButton" Content="−" Width="30" ToolTip.Tip="Zoom out (Ctrl+-, or scroll down)" />
        <TextBlock x:Name="ZoomText" Width="64" VerticalAlignment="Center"
                   TextAlignment="Center" FontFamily="monospace" Text="100%" />
        <Button x:Name="ZoomInButton" Content="+" Width="30" ToolTip.Tip="Zoom in (Ctrl++, or scroll up)" />
        <Rectangle Width="1" Fill="#30808080" Margin="4,2" />
        <Button x:Name="ResetParametersButton" Content="Reset parameters" />
        <ToggleButton x:Name="SourceButton" Content="Source"
                      ToolTip.Tip="Show the drawing's text" />
      </StackPanel>
    </Border>

    <Border x:Name="StatusPanel" DockPanel.Dock="Bottom"
            Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="#20808080">
      <StackPanel Spacing="4">
        <TextBlock x:Name="StatusText" Opacity="0.65" TextTrimming="CharacterEllipsis" />
        <Border x:Name="ErrorPanel" IsVisible="False"
                Padding="8" CornerRadius="4"
                Background="#33FF5555" BorderBrush="#88FF5555" BorderThickness="1">
          <SelectableTextBlock x:Name="ErrorText"
                               FontFamily="monospace" FontSize="11" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Border>

    <Grid x:Name="Body" RowDefinitions="*,6,220">

      <Grid x:Name="Drawing" Grid.Row="0" ColumnDefinitions="*,6,Auto">

        <viewer:SvgViewerCanvas x:Name="PART_Canvas" Grid.Column="0" />

        <GridSplitter x:Name="Splitter" Grid.Column="1"
                      ResizeDirection="Columns" Background="Transparent" />

        <Border x:Name="ParameterPanelHost" Grid.Column="2"
                Width="300" BorderThickness="1,0,0,0" BorderBrush="#20808080">
          <viewer:SvgViewerParameterPanel x:Name="PART_Parameters" />
        </Border>

      </Grid>

      <!--
        The text sits under the drawing rather than beside it because SVG lines are long, and the
        column to the right is the parameters' and only 300px wide.
      -->
      <GridSplitter x:Name="SourceSplitter" Grid.Row="1"
                    ResizeDirection="Rows" Background="Transparent" />

      <Border x:Name="SourcePanelHost" Grid.Row="2"
              BorderThickness="0,1,0,0" BorderBrush="#20808080">
        <!--
          A row per line in a virtualising list, so only the lines on screen are ever laid out. One
          text block holding the whole drawing is what put a size limit on colouring at all.
        -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <!--
            The scroller is the pane's, not the list's: an ItemsControl given a template of its own
            realises every row it has, however its panel is set. Measured at 4,000 rows — all 4,000
            built inside a custom template, 16 with the list simply placed in a ScrollViewer.
          -->
          <ItemsControl x:Name="SourceLines" Margin="8,6">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </Border>

    </Grid>

  </DockPanel>

</UserControl>
