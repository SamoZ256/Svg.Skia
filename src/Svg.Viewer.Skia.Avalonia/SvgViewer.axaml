<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewer="clr-namespace:Svg.Viewer.Skia.Avalonia"
             xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="Svg.Viewer.Skia.Avalonia.SvgViewer"
             DragDrop.AllowDrop="True">

  <UserControl.Styles>
    <!--
      Belt and braces. AvaloniaEdit 12 supplies its own control theme once a base theme is loaded
      (measured as byte-identical frames with this include, without it, and with it on the
      Application), so a host needs nothing. Only Fluent was tried, and one line here is cheaper
      than a host on another theme finding an unstyled control.
    -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <!--
      The right pane's tabs, which appear only once a host has put a panel of its own beside the
      parameters. Fluent styles a TabItem as a pivot header — 24pt type over a sliding pipe — which
      is half the width of the pane it would be sitting in, and the pipe is laid out for that type
      rather than this: at pane size it crosses the word it is meant to underline. Hence a template
      rather than a few setters over Fluent's, so the line is the border of the header itself and
      cannot land on top of it.
    -->
    <Style Selector="TabControl.panes > TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="0,0,0,2">
            <ContentPresenter Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="TabControl.panes > TabItem:selected">
      <Setter Property="Opacity" Value="1" />
      <!-- The brush Fluent paints its own pipe with, so only the line's position has changed. -->
      <Setter Property="BorderBrush" Value="{DynamicResource TabItemHeaderSelectedPipeFill}" />
    </Style>

    <Style Selector="TabControl.panes > TabItem:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Svg.Viewer.Skia.Avalonia/SvgViewerSourceBrushes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel LastChildFill="True">

    <Border x:Name="ToolBarPanel" DockPanel.Dock="Top"
            Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="#20808080">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button x:Name="FitButton" Content="Fit" ToolTip.Tip="Fit to window (Ctrl+0)" />
        <Button x:Name="ActualSizeButton" Content="1:1" ToolTip.Tip="Actual size (Ctrl+1)" />
        <Button x:Name="ResetButton" Content="Reset" ToolTip.Tip="Reset pan and zoom" />
        <Rectangle Width="1" Fill="#30808080" Margin="4,2" />
        <Button x:Name="ZoomOutButton" Content="−" Width="30" ToolTip.Tip="Zoom out (Ctrl+-, or scroll down)" />
        <TextBlock x:Name="ZoomText" Width="64" VerticalAlignment="Center"
                   TextAlignment="Center" FontFamily="monospace" Text="100%" />
        <Button x:Name="ZoomInButton" Content="+" Width="30" ToolTip.Tip="Zoom in (Ctrl++, or scroll up)" />
        <Rectangle Width="1" Fill="#30808080" Margin="4,2" />
        <Button x:Name="ResetParametersButton" Content="Reset parameters" />
        <ToggleButton x:Name="BoundsButton" Content="Bounds"
                      ToolTip.Tip="Outline the drawing's own edges" />
        <ToggleButton x:Name="SourceButton" Content="Source"
                      ToolTip.Tip="Show the drawing's text" />
      </StackPanel>
    </Border>

    <Border x:Name="StatusPanel" DockPanel.Dock="Bottom"
            Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="#20808080">
      <!--
        Two columns rather than two rows: a note about the drawing arrives and goes as it is edited,
        and a row that appears with it would shove the whole viewer up and down while someone types.
      -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Grid.Column="0" Opacity="0.65" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="NoteText" Grid.Column="1" IsVisible="False"
                   Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource SvgViewerSourceErrorBrush}" />
      </Grid>
    </Border>

    <Grid x:Name="Body" RowDefinitions="*,6,220">

      <Grid x:Name="Drawing" Grid.Row="0">

        <!--
          The width is on the column, not on the border in it. With Auto plus a Width="300" child,
          the splitter moved the column and the panel stayed 300 wide — so dragging it did nothing.
          Both ends have a minimum, because a splitter that can be dragged until one side vanishes
          gives no way back.
        -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="160" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="340" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">

          <viewer:SvgViewerCanvas x:Name="PART_Canvas" />

          <!--
            Over the drawing rather than under it, because what it says is that the drawing is not
            to be trusted, and the blur behind it says the same thing without words. The grid has no
            background of its own, so a pointer reaches the canvas everywhere except on the card —
            the drawing can still be panned while it is being explained.
          -->
          <Grid x:Name="ErrorPanel" IsVisible="False">

            <!--
              The frosting. A blur alone reads as a drawing out of focus; what says "there is
              something in front of this" is the tint over it, so the pane is blur plus a wash and
              not hit-testable, leaving the pointer to the canvas underneath.
            -->
            <Border x:Name="FaultScrim" IsHitTestVisible="False"
                    Background="{DynamicResource SvgViewerFaultScrimBrush}" />

            <Border MaxWidth="520" Padding="16" CornerRadius="6"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderThickness="1"
                    Background="{DynamicResource SvgViewerFaultBackgroundBrush}"
                    BorderBrush="{DynamicResource SvgViewerSourceErrorBrush}">
              <SelectableTextBlock x:Name="ErrorText"
                                   FontFamily="Cascadia Mono,Menlo,Consolas,DejaVu Sans Mono,monospace"
                                   FontSize="11" TextWrapping="Wrap" />
            </Border>
          </Grid>

        </Grid>

        <GridSplitter x:Name="Splitter" Grid.Column="1"
                      ResizeDirection="Columns" Background="Transparent" />

        <Border x:Name="DeclarationPanelHost" Grid.Column="2"
                BorderThickness="1,0,0,0" BorderBrush="#20808080">
          <viewer:SvgViewerDeclarationPanel x:Name="PART_Declarations" />
        </Border>

      </Grid>

      <!--
        The text sits under the drawing rather than beside it because SVG lines are long, and the
        column to the right is the declarations' and a few hundred pixels at most.
      -->
      <GridSplitter x:Name="SourceSplitter" Grid.Row="1"
                    ResizeDirection="Rows" Background="Transparent" />

      <Border x:Name="SourcePanelHost" Grid.Row="2"
              BorderThickness="0,1,0,0" BorderBrush="#20808080">
        <!--
          One document rather than a control per line, which is what lets a selection cross one.
          The editor virtualises by itself and colours only the lines on screen, so there is no size
          at which this gives up. Read-only for now; editing is the reason it is an editor.
        -->
        <edit:TextEditor x:Name="SourceEditor"
                         IsReadOnly="True"
                         ShowLineNumbers="True"
                         WordWrap="False"
                         FontFamily="Cascadia Mono,Menlo,Consolas,DejaVu Sans Mono,monospace"
                         FontSize="12"
                         Padding="8,6"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" />
      </Border>

    </Grid>

  </DockPanel>

</UserControl>
