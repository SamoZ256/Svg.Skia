<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles PaintCode's own generated drawing code, so the import can be diffed against the thing it
    was converted from. Deliberately absent from Svg.Skia.slnx: the sources it compiles live outside
    the repository and exist only on a machine that has the PaintCode resources, so nothing in the
    solution may depend on it. Set PaintCodeResourcesDir to that directory to switch it on.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>False</IsPackable>
    <Nullable>disable</Nullable>
    <!--
      124k lines of generated, nullable-oblivious C# transliterated from Java. Scoped to this project
      precisely so it cannot silence a warning in code anybody here writes.
    -->
    <NoWarn>$(NoWarn);CS0108;CS0164;CS0168;CS0219;CS0618;CS8073;CS8632</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\build\SkiaSharp.props" />

  <!--
    Every C# file directly in that folder, which is what PaintCode2Skia writes: its runtime shim and
    a class per style kit. Not a recursive glob, because a folder may hold a UI subtree beside them, as
    this one's SkeletUI does, needing dependencies this project has no business carrying. Override
    PaintCodeOracleSources where that default does not suit a particular export.
  -->
  <PropertyGroup Condition="'$(PaintCodeOracleSources)' == ''">
    <PaintCodeOracleSources>$(PaintCodeResourcesDir)\*.cs</PaintCodeOracleSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(PaintCodeResourcesDir)' != '' And Exists('$(PaintCodeResourcesDir)')">
    <Compile Include="$(PaintCodeOracleSources)" />
  </ItemGroup>

</Project>
