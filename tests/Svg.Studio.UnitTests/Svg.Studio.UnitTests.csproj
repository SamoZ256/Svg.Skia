<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>False</IsPackable>
    <Nullable>enable</Nullable>
    <RootNamespace>Svg.Studio.UnitTests</RootNamespace>
  </PropertyGroup>

  <Import Project="..\..\build\ReferenceAssemblies.props" />
  <Import Project="..\..\build\XUnit.v3.props" />
  <Import Project="..\..\build\SkiaSharp.props" />
  <Import Project="..\..\build\SkiaSharp.Native.props" />
  <Import Project="..\..\build\SkiaSharp.Avalonia.props" />
  <Import Project="..\..\build\Avalonia.props" />
  <Import Project="..\..\build\Avalonia.Skia.props" />
  <Import Project="..\..\build\Avalonia.Themes.Fluent.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\Svg.Studio\Svg.Studio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestAssets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Linked rather than committed as a second .pcvd: what these tests assert is the numbers a
      document was built with, and a binary asset says none of them. The archive builder is the only
      way to write one, and it lives with the reader it was written for.
    -->
    <Compile Include="..\Svg.PaintCode.UnitTests\Bplist.cs" Link="Fixtures\Bplist.cs" />
    <Compile Include="..\Svg.PaintCode.UnitTests\KeyedArchiveBuilder.cs" Link="Fixtures\KeyedArchiveBuilder.cs" />
    <Compile Include="..\Svg.PaintCode.UnitTests\DeskDocument.cs" Link="Fixtures\DeskDocument.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <!-- Named rather than left transitive: making a tab dirty means typing into the pane's editor. -->
  </ItemGroup>

</Project>
